# oai-tts-router environment variables

# Port the server listens on (default: 3000)
# PORT=3000

# API keys for authentication. Comma-separated for multiple keys.
# Leave empty to disable authentication (all requests accepted).
# API_KEY=sk-my-secret-key,sk-another-key

# TTS response cache size. Supports b, kb, mb, gb suffixes.
# Set to "0" or empty to disable caching (default: 0).
# TTS_CACHE_SIZE=100mb

# Log level (debug, info, warn, error). Default: info
# LOG_LEVEL=info

# HTTP/HTTPS proxy for outbound requests (e.g., TTS API calls)
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
