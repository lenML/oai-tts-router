# oai-tts-router environment variables
#
# 1) Use config.json (see config.example.json) as your primary configuration source.
#    It supports all options with full type safety.
# 2) Only use .env to override config.json for sensitive values (e.g. API keys)
#    or for Docker deployments where you configure via docker compose environment.
#    In most cases you don't need to touch this file.
#
# Port (overrides config.json "port")
# PORT=4567

# Vite Playground development server
# VITE_DEV_PORT=5173
# VITE_PROXY_TARGET=http://127.0.0.1:4567

# Static build settings
# VITE_BASE_PATH=/playground/
# VITE_API_BASE_URL=https://tts.example.com/v1

# API keys for authentication. Comma-separated (overrides config.json "api_keys").
# Leave empty to disable authentication (all requests accepted).
# API_KEY=sk-my-secret-key,sk-another-key

# Provider credentials. These override config.json provider credential lists.
# XAI_CONSOLE_COOKIE=sso=...; sso-rw=...; __cf_bm=...
# GEMINI_TOKEN=your-recaptcha-token

# Grok Console Cloudflare/DPoP options.
# FLARESOLVERR_URL=http://127.0.0.1:8191
# FLARESOLVERR_PROXY=http://proxy.example.com:8080
# GROK_BROWSER_VERSION=146

# TTS response cache size (overrides config.json "cache.tts_size").
# Supports b, kb, mb, gb suffixes. Set to "0" or empty to disable caching.
# TTS_CACHE_SIZE=100mb

# Log level (debug, info, warn, error). Overrides config.json "log_level".
# LOG_LEVEL=info

# Browser origins allowed to call the API. Comma-separated. Use "*" to allow all.
# CORS_ORIGIN=https://lenml.github.io,http://localhost:5173

# HTTP/HTTPS proxy for outbound requests (overrides config.json "proxy").
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080

# Custom config.json path (default: ./config.json in project root)
# CONFIG_PATH=/etc/oai-tts-router/config.json

# For Docker deployments, prefer setting these variables in docker compose
# (environment section) rather than a .env file at runtime.